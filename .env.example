# ─── Database ─────────────────────────────────────────
POSTGRES_USER=smartcity
POSTGRES_PASSWORD=smartcity_secret_2024
POSTGRES_DB=smartcity_osint
DATABASE_URL=postgresql+asyncpg://smartcity:smartcity_secret_2024@db:5432/smartcity_osint

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── JWT Authentication ──────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Default Admin ───────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ─── OSINT API Keys (REQUIRED for real scanning) ────
# Shodan: https://account.shodan.io/
SHODAN_API_KEY=your_shodan_api_key_here

# Censys: https://search.censys.io/account/api
# You can provide either a modern Personal Access Token (PAT):
CENSYS_API_KEY=your_censys_personal_access_token_here
CENSYS_ORG_ID=
# OR the legacy API ID and Secret:
CENSYS_API_ID=
CENSYS_API_SECRET=

# ─── Scanning Scope ──────────────────────────────────
# Comma-separated list of cities to scan for Smart City infrastructure.
# These are passed as the `city:` dork parameter to Shodan/Censys.
SCAN_CITIES_KZ=Almaty,Astana,Shymkent,Karaganda,Aktobe

# ─── Scanning Rate Limits ────────────────────────────
# Max Shodan results to collect per individual dork query (pagination cap).
# Prevents RAM exhaustion on large city queries (e.g., city:"Almaty" port:554).
SHODAN_MAX_RESULTS_PER_QUERY=200
# Max pages to fetch from Censys per query (each page = 100 hosts).
CENSYS_MAX_PAGES=5

# ─── App Settings ────────────────────────────────────
APP_NAME=SmartCity OSINT Platform
APP_VERSION=0.2.0
DEBUG=false
