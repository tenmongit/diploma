# ═══════════════════════════════════════════════════════════
# SmartCity OSINT Platform — Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env:  cp .env.example .env
# No manual edits required for demonstration mode.

# ─── Database ─────────────────────────────────────────
POSTGRES_USER=smartcity
POSTGRES_PASSWORD=smartcity_secret_2024
POSTGRES_DB=smartcity_osint
DATABASE_URL=postgresql+asyncpg://smartcity:smartcity_secret_2024@db:5432/smartcity_osint

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── JWT Authentication ──────────────────────────────
JWT_SECRET_KEY=demo-secret-key-for-diploma-defense-2024
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Default Admin Credentials ───────────────────────
# Use these to log in at http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ─── OSINT API Keys (not required in demo mode) ──────
# Leave empty for demonstration; seed_demo_data.py
# populates the database with synthetic data.
SHODAN_API_KEY=
CENSYS_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
CENSYS_ORG_ID=

# ─── Scanning Scope ──────────────────────────────────
SCAN_CITIES_KZ=Almaty,Astana

# ─── App Settings ────────────────────────────────────
APP_NAME=SmartCity OSINT Platform
APP_VERSION=1.0.0
DEBUG=false
